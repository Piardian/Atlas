# ================================================================
# Google AI Studio (Gemini) Multi-Agent Orchestrator Config
# ================================================================

# 4 Adet Google AI Studio API Anahtari (Rate Limit Asimini Onlemek Icin)
GEMINI_USER_A_KEY=your_gemini_api_key_a_here
GEMINI_USER_B_KEY=your_gemini_api_key_b_here
GEMINI_USER_C_KEY=your_gemini_api_key_c_here
GEMINI_USER_D_KEY=your_gemini_api_key_d_here

# Model Konfigurasyonlari (Dogrudan Google AI Studio)
PLANNER_MODEL=gemini/gemini-2.5-pro
CODER_MODEL=gemini/gemini-2.5-flash
REVIEWER_MODEL=gemini/gemini-2.5-pro

# Varsayilan Hedef Proje Calisma Alani
TARGET_WORKSPACE=./workspace_project
